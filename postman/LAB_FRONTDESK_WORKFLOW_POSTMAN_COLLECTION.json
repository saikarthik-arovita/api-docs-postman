  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "1. Lab Frontdesk Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.access_token);",
                  "    pm.environment.set('authToken', jsonData.data.access_token);",
                  "    console.log('Auth token successfully captured.');",
                  "}",
                  "if (jsonData.data && jsonData.data.user && jsonData.data.user.branch_id) {",
                  "    pm.collectionVariables.set('tenantId', jsonData.data.user.branch_id);",
                  "    pm.environment.set('tenantId', jsonData.data.user.branch_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lab_frontdesk@arovita.com\",\n  \"password\": \"Arovita@2026\",\n  \"device_info\": \"Postman Lab Client\"\n}"
            },
            "url": {
              "raw": "{{auth_base_url}}/login",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticates the lab frontdesk user and captures the JWT Bearer token."
          },
          "response": []
        },
        {
          "name": "2. Get Current Profile",
          "request": {
            "method": "GET",
